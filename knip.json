{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout}.tsx",
    "src/app/**/route.ts",
    "tests/**/*.test.ts",
    "src/domain/types.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["e2e/**"],
  "ignoreDependencies": [
    "@vitest/coverage-v8",
    "vitest",
    "tailwindcss",
    "dependency-cruiser",
    "type-coverage",
    "knip",
    "prettier",
    "eslint-config-prettier",
    "typescript-eslint",
    "@tailwindcss/postcss"
  ]
}
