{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout}.tsx",
    "tests/**/*.test.ts",
    "src/domain/types.ts",
    "src/domain/insights.ts",
    "src/domain/drills.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["e2e/**"],
  "ignoreBinaries": ["uvx"],
  "ignoreDependencies": ["tailwindcss"]
}
