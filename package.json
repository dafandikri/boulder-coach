{
  "name": "boulder-coach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "type-coverage": "type-coverage --at-least 99 --strict --ignore-files \".next/**\" --ignore-files \"e2e/**\" --ignore-files \"tests/**\"",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:safety": "vitest run tests/domain/adaptation.test.ts tests/domain/adaptation.invariants.test.ts tests/domain/loadMetrics.test.ts",
    "gate": "bash scripts/gate.sh",
    "onboard": "bash scripts/onboard.sh",
    "learnings": "bash scripts/learnings.sh",
    "crew": "node scripts/crew/crew.mjs",
    "prepare": "husky",
    "e2e": "playwright test",
    "semgrep": "uvx semgrep --config=p/default --config=p/typescript --error --metrics=off src"
  },
  "dependencies": {
    "dexie": "^4.4.3",
    "geist": "^1.7.2",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "type-coverage": "^2.29.7",
    "typescript": "^5",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
