{
  "permissions": {
    "allow": [
      "Bash(pnpm onboard)",
      "Bash(pnpm install:*)",
      "Bash(pnpm gate)",
      "Bash(pnpm test:*)",
      "Bash(pnpm vitest:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm format:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git push:*)",
      "Bash(git push)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/onboard.sh quick 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm gate >/tmp/gate.log 2>&1 || { echo 'BLOCKED: gate failing. See /tmp/gate.log. Fix before claiming done.'; exit 2; }"
          }
        ]
      }
    ]
  }
}
